# Copia este archivo como .env (en esta misma carpeta central/) y cambia
# TODOS los valores "cambia_esto". El .env real no se sube al repositorio.
# Para generar claves:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# ---------- Base de datos local (MariaDB) ----------
MARIADB_ROOT_PASSWORD=cambia_esto_root
MARIADB_DATABASE=huerto
MARIADB_USER=huerto
MARIADB_PASSWORD=cambia_esto
DB_HOST=mariadb
DB_PORT=3306
# Puerto publicado SOLO en 127.0.0.1 de la Pi (para herramientas y exportación)
DB_PUERTO_LOCAL=3306

# ---------- MQTT (Mosquitto) ----------
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Usuarios de los servicios (los de cada nodo se crean con mosquitto/usuarios.sh nodo <id>)
MQTT_USER_PROCESADOR=procesador
MQTT_PASS_PROCESADOR=cambia_esto_procesador
MQTT_USER_WEB=web
MQTT_PASS_WEB=cambia_esto_web
# Solo para pruebas con tools/simular_nodos.py. En producción puedes no crearlo.
MQTT_USER_SIMULADOR=simulador
MQTT_PASS_SIMULADOR=cambia_esto_simulador

# ---------- Reglas (se usan desde la etapa 2) ----------
ZONA_HORARIA=America/Santiago
HISTERESIS_SUELO=2
HISTERESIS_TEMP=1
CALOR_MINUTOS_SOSTENIDO=30
UMBRAL_LUZ_LUX=25000
DIAS_POCA_LUZ=3
# Horario de sol usado para saber si un día de luz tiene datos suficientes
HORA_INICIO_SOL=6
HORA_FIN_SOL=21
COBERTURA_MINIMA_LUZ=0.75
MINUTOS_SIN_DATOS_GRIS=120
# Sensores que ponen la cama en gris si dejan de enviar. Prototipo 1: sin sensor
# de luz. Cuando haya sensor de luz: suelo,temperatura,luz
SENSORES_REQUERIDOS=suelo,temperatura
# Saltos imposibles entre lecturas consecutivas (por minuto)
SALTO_MAX_BAJADA_SUELO=10
SALTO_MAX_TEMP=3
SALTO_MAX_HUM_AIRE=15
# Rango físico del sensor de aire (DHT11: 0 a 50 °C, no mide bajo cero).
# Un valor fuera de rango se guarda marcado como inválido.
TEMP_MIN_FISICO=0
TEMP_MAX_FISICO=50
HUM_AIRE_MIN_FISICO=0
HUM_AIRE_MAX_FISICO=100
# RF-15: alerta preventiva «tendencia_secado» (desactivada por defecto).
# Estos son los valores por defecto: ventana, R² y la alerta se editan en /configuracion.
TENDENCIA_ACTIVA=false
TENDENCIA_VENTANA_H=6
TENDENCIA_R2_MIN=0.6
TENDENCIA_MIN_PUNTOS=12
TENDENCIA_HORIZONTE_H=6

# ---------- Clima externo de referencia (no es un pronóstico) ----------
# Valores POR DEFECTO: el docente puede cambiar proveedor, latitud y longitud en
# /configuracion (se guardan en la BD). Por defecto: San Ramón / La Pintana.
# Proveedores: open-meteo (gratis, sin clave) | dmc | openweather
CLIMA_PROVEEDOR=open-meteo
CLIMA_LAT=-33.54
CLIMA_LON=-70.64
# Minutos que el tablero reutiliza el último dato antes de volver a consultar
CLIMA_TTL_MIN=20
# DMC (opcional): registro en https://climatologia.meteochile.gob.cl
# Si faltan, el proveedor aparece como «no configurado» (sin errores).
DMC_USER_EMAIL=
DMC_API_TOKEN=
# Código nacional de la estación automática (EMA) más cercana; también se edita en /configuracion
DMC_ESTACION=
# OpenWeatherMap (opcional): basta la key gratuita (Current Weather)
OPENWEATHER_API_KEY=

# ---------- Capa de datos para análisis (calidad y agregados) ----------
# Cada cuánto mide el nodo, en segundos (INTERVALO_MS del firmware / 1000)
INTERVALO_LECTURA_S=30
# «Hueco» = faltan MÁS de estas lecturas seguidas
HUECO_LECTURAS_FALTANTES=2
# «Sensor pegado» = el mismo valor exacto por más de estas horas
PEGADO_HORAS_SUELO=3
PEGADO_HORAS_TEMP=6
PEGADO_HORAS_HUM_AIRE=6
# Riego detectado: la humedad del suelo sube al menos RIEGO_UMBRAL_PTS puntos en
# RIEGO_VENTANA_MIN minutos o menos
RIEGO_UMBRAL_PTS=10
RIEGO_VENTANA_MIN=30
# Etiquetas de la tendencia del suelo (puntos % por hora, valores de ejemplo):
# más rápido que -1 = «Secándose rápido»; entre -0,2 y +0,2 = «Estable»
TENDENCIA_PTS_RAPIDO=1.0
TENDENCIA_PTS_ESTABLE=0.2

# ---------- Tablero ----------
# Dónde escucha. En la casa: 0.0.0.0 y 8080. En el servidor (detrás de nginx):
#   WEB_ESCUCHA=127.0.0.1  WEB_PUERTO=18020  MQTT_ESCUCHA=127.0.0.1
#   PROXY_SALTOS=1  COOKIE_SEGURA=true
WEB_ESCUCHA=0.0.0.0
MQTT_ESCUCHA=0.0.0.0
# Puerto de MQTT en el host (los servicios usan 1883 dentro de Docker igual)
MQTT_PUERTO_LOCAL=1883
PROXY_SALTOS=0
COOKIE_SEGURA=false
# También recibe las lecturas de los ESP32: POST http://IP_DEL_PC:8080/api/lecturas
# El token de cada nodo se crea con:  docker compose exec web python -m web.nodos crear cama-a
WEB_PUERTO=8080
# Página del proyecto (/proyecto): correo que recibe las solicitudes del formulario
# «Sumarse al piloto». El sistema no guarda esos datos: el formulario abre el
# correo del visitante con el mensaje listo. Vacío = macarena@mjamett.cl
# (PILOTO_CORREO_POR_DEFECTO en web/web/config.py).
PILOTO_CORREO=

# Exportación para análisis (/api/exportar/<conjunto>.csv) desde scripts o notebooks:
#   Authorization: Bearer <EXPORT_TOKEN>   (mínimo 16 caracteres; vacío = solo con el PIN)
EXPORT_TOKEN=

# PIN del docente para la vista de configuración (solo números, mínimo 4)
PIN_DOCENTE=cambia_esto
